# ContractGuard Environment Variables Template
# Copy this file to .env and configure your local settings

# LLM-Judge Layer API Keys (Optional - ContractGuard will automatically use offline heuristics if unset)
OPENAI_API_KEY=sk-dummy-openai-key-replace-with-actual-token
GEMINI_API_KEY=AIzaSyDummyGeminiKeyReplaceWithActualToken

# LLM Model Configuration
CONTRACTGUARD_LLM_MODEL=gpt-4o
CONTRACTGUARD_LLM_TEMPERATURE=0.1
CONTRACTGUARD_LLM_TIMEOUT_SECONDS=30

# Analysis Engine Flags & Offline Mode
CONTRACTGUARD_OFFLINE=false
CONTRACTGUARD_ENABLE_SLITHER=true
CONTRACTGUARD_ENABLE_MYTHRIL=true
CONTRACTGUARD_ENABLE_AST_ANALYZER=true
CONTRACTGUARD_SLITHER_TIMEOUT=120
CONTRACTGUARD_MYTHRIL_TIMEOUT=30
CONTRACTGUARD_MIN_SEVERITY=informational

# Report Configuration
CONTRACTGUARD_REPORT_FORMAT=all
CONTRACTGUARD_OUTPUT_DIR=reports

