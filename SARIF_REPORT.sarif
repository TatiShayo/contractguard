          "level": "warning",
          "message": {
            "text": "[MEDIUM] Use of tx.origin: Function 'changeOwner' in contract 'Telephone' uses 'tx.origin' for authorization. An attacker can exploit this via phishing or malicious proxy contracts to impersonate the user. (Also reported by Mythril: Use of tx.origin for authorization may result in a vulnerability if the user is tricked into calling a malicious contract.)"
          },
          "locations": [
            {
              "physicalLocation": {
