{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ContractGuard",
          "version": "2.0.0",
          "informationUri": "https://github.com/contractguard/contractguard",
          "rules": [
            {
              "id": "CG-001-REENTRANCY",
              "name": "Reentrancy / State access after external call",
              "shortDescription": {
                "text": "Reentrancy Vulnerability"
              },
              "fullDescription": {
                "text": "State variable modified after external call (e.g. call.value, send, transfer), allowing reentrant control flow to hijack contract state."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "cwe": "CWE-841",
                "precision": "high"
              }
            },
            {
              "id": "CG-012-USELESS-STATEMENT",
              "name": "Useless statement",
              "shortDescription": {
                "text": "Useless Statement / Dead Code"
              },
              "fullDescription": {
                "text": "Expression statement has no effect on contract state or control flow (e.g. `_amount;` or `this;`)."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "cwe": "CWE-561",
                "precision": "high"
              }
            },
            {
              "id": "CG-002-TX-ORIGIN",
              "name": "Use of tx.origin",
              "shortDescription": {
                "text": "tx.origin Authentication Bypass"
              },
              "fullDescription": {
                "text": "Authentication or authorization logic relies on `tx.origin` instead of `msg.sender`."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "cwe": "CWE-284",
                "precision": "high"
              }
            },
            {
              "id": "CG-005-ACCESS-CONTROL",
              "name": "Missing Access Control on Sensitive Function",
              "shortDescription": {
                "text": "Missing Access Control on Sensitive Function"
              },
              "fullDescription": {
                "text": "Sensitive administrative or state-altering function is publicly callable without caller authentication or role restrictions."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "cwe": "CWE-284",
                "precision": "high"
              }
            },
            {
              "id": "CG-014-MISSING-ZERO-CHECK",
              "name": "missing-zero-check",
              "shortDescription": {
                "text": "Missing Zero-Address Validation"
              },
              "fullDescription": {
                "text": "Critical address parameter (e.g. new owner or token address) is assigned without checking against `address(0)`."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "cwe": "CWE-20",
                "precision": "medium"
              }
            },
            {
              "id": "CG-003-CONTROLLED-DELEGATECALL",
              "name": "Controlled delegatecall / Delegatecall to user-supplied address",
              "shortDescription": {
                "text": "Controlled / Arbitrary Delegatecall"
              },
              "fullDescription": {
                "text": "The contract executes `delegatecall` to a user-supplied target address or with caller-controlled calldata without strict access control."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "cwe": "CWE-829",
                "precision": "high"
              }
            },
            {
              "id": "CG-008-FLASHLOAN-ACCESS-CONTROL",
              "name": "Lack of Access Control in Flash Loan",
              "shortDescription": {
                "text": "Lack of Access Control in Flash Loan Initiation"
              },
              "fullDescription": {
                "text": "The flash loan function allows any sender to initiate a flash loan on behalf of an arbitrary receiver contract that pays a fixed fee."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "cwe": "CWE-284",
                "precision": "high"
              }
            },
            {
              "id": "CG-017-FLOATING-PRAGMA",
              "name": "Floating or Outdated Solidity Pragma",
              "shortDescription": {
                "text": "Floating or Outdated Solidity Pragma"
              },
              "fullDescription": {
                "text": "Contract uses a floating compiler version (e.g. `^0.8.0`) or an outdated Solidity version vulnerable to known compiler bugs."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "cwe": "CWE-1038",
                "precision": "medium"
              }
            },
            {
              "id": "CG-006-ARBITRARY-CALL",
              "name": "Arbitrary External Call Execution",
              "shortDescription": {
                "text": "Arbitrary External Call Execution"
              },
              "fullDescription": {
                "text": "Contract executes an external call to an arbitrary user-supplied target with user-supplied calldata with `msg.sender` as the contract itself."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "cwe": "CWE-841",
                "precision": "high"
              }
            },
            {
              "id": "CG-021-UNCHECKED-ERC20-TRANSFER",
              "name": "Unchecked ERC20 Transfer Return Value",
              "shortDescription": {
                "text": "Unchecked ERC20 Transfer Return Value"
              },
              "fullDescription": {
                "text": "Standard ERC20 `.transfer()` or `.transferFrom()` return value is ignored, or contract interacts with non-standard tokens (like USDT) that do not return a boolean."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "cwe": "CWE-252",
                "precision": "high"
              }
            },
            {
              "id": "CG-007-FLASHLOAN-DEPOSIT-REENTRANCY",
              "name": "Deposit-based Flash Loan Reentrancy",
              "shortDescription": {
                "text": "Deposit-based Flash Loan Reentrancy"
              },
              "fullDescription": {
                "text": "Flash loan pool checks repayment via total pool balance (`address(this).balance` or `token.balanceOf(this)`), allowing borrower to deposit the loan back into their internal balance during the callback."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "cwe": "CWE-841",
                "precision": "high"
              }
            },
            {
              "id": "CG-011-INTEGER-OVERFLOW",
              "name": "Integer Overflow / Underflow in Unchecked Block",
              "shortDescription": {
                "text": "Integer Overflow / Underflow in Unchecked Block"
              },
              "fullDescription": {
                "text": "Arithmetic operation executed inside `unchecked { ... }` block (Solidity >=0.8) without precondition validation, or in Solidity <0.8 without SafeMath."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "cwe": "CWE-190",
                "precision": "medium"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CG-001-REENTRANCY",
          "level": "error",
          "message": {
            "text": "[HIGH] Reentrancy / State access after external call: In contract 'Reentrancy', function 'withdraw' performs an external call before updating persistent state (balances[msg.sender] -=). An attacker can reenter this function before balances are deducted. (Also reported by Mythril: Write to persistent state ('balances[msg.sender]') after external call ('msg.sender.call').)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Reentrancy.sol",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 15,
                  "endLine": 23,
                  "startColumn": 1,
                  "endColumn": 80,
                  "snippet": {
                    "text": ""
                  }
                }
              }
            }
          ],
          "properties": {
            "cwe": "CWE-841",
            "confidence": "High",
            "sourceTool": "ast_analyzer, mythril",
            "impact": "Malicious contracts can reenter the vulnerable function recursively before internal state is updated, draining ether or token balances.",
            "remediation": "1. Apply the Checks-Effects-Interactions (CEI) pattern: perform all internal state updates before making external calls.\n2. Use OpenZeppelin's `ReentrancyGuard` and apply the `nonReentrant` modifier to functions making external transfers."
          }
        },
        {
          "ruleId": "CG-012-USELESS-STATEMENT",
          "level": "note",
          "message": {
            "text": "[LOW] Useless statement: The statement '_amount;' inside 'withdraw' has no effect and should be removed. (Also reported by Mythril: The statement '_amount;' inside withdraw has no effect and should be removed.)"
